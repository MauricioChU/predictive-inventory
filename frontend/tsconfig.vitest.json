{
  "extends": "./tsconfig.app.json",

  // Override to include only test files and clear exclusions.
  // Application code imported in tests is automatically included via module resolution.
  "include": [
    "src/**/__tests__/*",
    "src/**/*.spec.ts",
    // Ola 3, ruling 3: excluidos de tsconfig.app.json; se type-checan aquí, con tipos de Node.
    "src/**/__pruebas__/**/*",
    "tests/**/*.ts",
    "scripts/**/*.spec.ts",
    "eslint-rules/**/*.ts",
    // Fix round 2, M4: excluida de tsconfig.app.json (usa node:async_hooks); este proyecto
    // sí tiene tipos de Node, así que la incluye explícitamente.
    "src/shared/infrastructure/memoria/unidad-de-trabajo-en-memoria.ts",
    "env.d.ts"
  ],
  "exclude": [],

  "compilerOptions": {
    // Vitest runs in a different environment than the application code.
    // Adjust lib and types accordingly.
    // ES2022 (en vez de []) para que `Error(mensaje, { cause })` tenga tipos
    // (el runner de Gherkin de tests/gherkin/ejecutar-feature.ts lo usa).
    "lib": ["ES2022"],
    "types": ["node", "jsdom"],

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}

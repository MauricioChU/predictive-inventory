{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": [
    "src/**/__tests__/*",
    "src/**/*.spec.ts",
    // Ola 3, ruling 3: los ayudantes de prueba no son código de la app (pueden usar Node).
    "src/**/__pruebas__/**",
    // Fix round 2, M4: usa node:async_hooks (no existe en el navegador). Solo *.spec.ts y
    // tests/** pueden importarla (eslint-rules/fronteras.ts); el proyecto de la app no la
    // type-checa para no necesitar tipos de Node en un proyecto con lib solo de navegador.
    "src/shared/infrastructure/memoria/unidad-de-trabajo-en-memoria.ts"
  ],
  "compilerOptions": {
    // Extra safety for array and object lookups, but may have false positives.
    "noUncheckedIndexedAccess": true,

    // Path mapping for cleaner imports.
    "paths": {
      "@/*": ["./src/*"]
    },

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
